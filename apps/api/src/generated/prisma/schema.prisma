datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum UserRole {
  CLIENT
  STUDIO_LEAD
  ADMIN
}

enum ProductType {
  UI_KIT
  CHEATSHEET_HIGH_LEVEL
  CHEATSHEET_LOW_LEVEL
  CONSULTATION_AUDIT
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Lead {
  id             String     @id @default(uuid())
  name           String
  contact        String
  budget         String
  description    String
  serviceType    String     @default("FULL_CYCLE_ENGINEERING")
  referrer       String?
  idempotencyKey String?    @unique
  status         LeadStatus @default(NEW)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model User {
  id           String        @id @default(uuid())
  telegramId   String?       @unique
  username     String?
  firstName    String?
  email        String?       @unique
  role         UserRole      @default(CLIENT)
  purchases    Purchase[]
  customOrders CustomOrder[]
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Product {
  id             String      @id @default(uuid())
  slug           String      @unique
  title          String
  type           ProductType
  priceUsd       Float
  description    String
  tier           String      @default("CORE")
  badge          String      @default("STANDARD")
  version        String      @default("1.0.0")
  fileSize       String?
  componentCount Int?
  features       Json        @default("[]")
  artifactKey    String      @default("")
  isActive       Boolean     @default(true)
  purchases      Purchase[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([isActive])
}

model Purchase {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  amountUsd   Float
  status      OrderStatus @default(PENDING)
  downloadUrl String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model CustomOrder {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  budgetUsd      Float
  status         OrderStatus @default(PENDING)
  sprint         String?
  deliveryDate   DateTime?
  nextReviewDate DateTime?
  milestones     Milestone[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
}

model Milestone {
  id          String          @id @default(uuid())
  orderId     String
  order       CustomOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step        Int
  title       String
  description String
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([orderId, step])
  @@index([orderId])
}

model SystemShowcase {
  id          String   @id @default(uuid())
  slug        String   @unique
  number      String
  category    String
  title       String
  tagline     String
  description String
  topology    Json
  metrics     Json
  recentLog   String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model NotificationLog {
  id           String   @id @default(uuid())
  channel      String
  recipient    String
  payload      Json
  delivered    Boolean  @default(false)
  attempts     Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([channel])
  @@index([recipient])
  @@index([delivered])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
