# ===========================================
# Induktr Portfolio — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Both Vercel and Hugging Face environments need these.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=your_admin_telegram_chat_id

# --- Optional: Webhook secret (Telegram verifies this header on POST) ---
# TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# --- Authentication ---
SESSION_SECRET=your_session_secret_min_32_chars

# --- Agent API (for /api/agent/command) ---
AGENT_SECRET_KEY=your_agent_api_secret

# --- App URL (used for constructing links) ---
NEXT_PUBLIC_APP_URL=https://induktr-portfolio.vercel.app
